---
import BaseLayout from '../layouts/BaseLayout.astro';

import Hero from '../components/Hero.astro';
import Icon from '../components/Icon.astro';
import Pill from '../components/Pill.astro';

import ContactCTA from '../components/ContactCTA.astro';
import Skills from '../components/Skills.astro';
---

<BaseLayout title="Home | Abid Nasim">
	<div class="stack gap-20 lg:gap-48">
		<div class="wrapper stack gap-8 lg:gap-20">
			<header class="hero">
				<Hero
					title="Hello, my name is Abid Nasim"
					tagline="I am a full stack Platform Engineer."
					align="start"
				>
					<div class="roles">
						<Pill><Icon icon="code" size="1.33em" /> Developer</Pill>
						<Pill><Icon icon="pencil-line" size="1.33em" /> Writer</Pill>
						<Pill><Icon icon="trophy" size="1.33em" /> Mentor</Pill>
					</div>
				</Hero>

				<div class="hero-portrait-wrap">
				<span class="hero-portrait-tooltip">See About for my contact card QR code</span>
				<img
					alt="Abid Nasim standing"
					width="260"
					height="488"
					src="/assets/AN-Rotana.jpg"
					class="hero-portrait"
				/>
			</div>
			</header>

			<Skills locale="en" />
		</div>

		<ContactCTA />
	</div>
</BaseLayout>



<style>
	.hero {
		display: flex;
		flex-direction: column;
		align-items: center;
		gap: 2rem;
	}

	.roles {
		display: none;
	}

	.hero-portrait-wrap {
		aspect-ratio: 853 / 1600;
		overflow: hidden;
		border-radius: 1.5rem;
		box-shadow: var(--shadow-md);
	}

	.hero-portrait {
		width: 100%;
		height: 100%;
		object-fit: cover;
		object-position: top;
	}

	@media (min-width: 50em) {
		.hero {
			display: grid;
			grid-template-columns: 6fr 4fr;
			padding-inline: 2.5rem;
			gap: 3.75rem;
		}

		.roles {
			margin-top: 0.5rem;
			display: flex;
			gap: 0.5rem;
		}

		.hero-portrait-wrap {
			border-radius: 4.5rem;
		}
	}

</style>
